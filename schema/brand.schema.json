{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dehbini/giftcard-catalog/main/schema/brand.schema.json",
  "title": "Gift card catalog",
  "type": "object",
  "required": ["version", "updated", "brands"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "disclaimer": { "type": "string" },
    "brands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/brand" }
    }
  },
  "$defs": {
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "publisher",
        "category",
        "deliveryType",
        "lock",
        "redeemUrl",
        "expires",
        "regions"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["gaming", "app-store", "streaming", "retail", "subscription"]
        },
        "deliveryType": { "enum": ["code", "gift-link", "account-topup"] },
        "lock": { "$ref": "#/$defs/lock" },
        "redeemUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
        "code": { "$ref": "#/$defs/codeSpec" },
        "expires": { "type": "boolean" },
        "expiryNote": { "type": "string" },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/region" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "expires": { "const": true } }, "required": ["expires"] },
          "then": { "required": ["expiryNote"] }
        },
        {
          "if": { "properties": { "deliveryType": { "const": "code" } }, "required": ["deliveryType"] },
          "then": { "required": ["code"] },
          "else": { "not": { "required": ["code"] } }
        }
      ]
    },
    "codeSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lengths", "verifiedAt"],
      "properties": {
        "lengths": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "groups": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "separator": { "type": "string", "maxLength": 1 },
        "alphabet": { "type": "string", "pattern": "^[A-Z0-9]+$" },
        "prefixes": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z0-9]+$" } },
        "source": { "type": "string", "pattern": "^https://" },
        "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyedOn", "onMismatch", "note", "verifiedAt"],
      "properties": {
        "keyedOn": { "enum": ["account-country", "store-currency", "storefront", "none"] },
        "onMismatch": { "enum": ["rejected", "accepted", "value-differs"] },
        "remedy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["possible", "destructive", "note"],
          "properties": {
            "possible": { "type": "boolean" },
            "destructive": { "type": "boolean" },
            "note": { "type": "string", "minLength": 10 }
          }
        },
        "note": { "type": "string", "minLength": 10 },
        "source": { "type": "string", "pattern": "^https://" },
        "verifiedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "currency", "denominations"],
      "properties": {
        "code": { "type": "string", "pattern": "^([A-Z]{2}|EU|GLOBAL)$" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "denominations": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "unit": { "enum": ["robux", "months", "subscription"] }
      }
    }
  }
}
